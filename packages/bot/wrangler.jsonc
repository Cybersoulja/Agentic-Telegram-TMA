{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trillastrob",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MINI_APP_URL": "https://telegram-mini-app-frontend.pages.dev",
    "N8N_URL": "http://localhost:5678",
    "QWEN_TTS_URL": "http://localhost:8080",
    "NOVELAI_AGENT_PATH": "<path-to-novelai-lorebook-agent>",
    "MIRROR_LEECH_URL": "http://localhost:8095",
    "BLUESKY_PDS_URL": "http://localhost:2583"
  },
  // TODO: "tma-kv-dev" and "tma-db-dev" below are local-dev-only placeholders — `wrangler dev`
  // doesn't validate them, but a real `wrangler deploy` (e.g. via Workers Builds) will reject
  // them as invalid resource IDs. Swap in the real KV namespace id / D1 database_id once those
  // are provisioned in the Cloudflare account this Worker deploys to.
  "kv_namespaces": [
    {
      "binding": "TMA_KV",
      "id": "tma-kv-dev"
    }
  ],
  "d1_databases": [
    {
      "binding": "TMA_DB",
      "database_name": "tma_db",
      "database_id": "tma-db-dev"
    }
  ]
}
