{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trillastrob",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MINI_APP_URL": "https://telegram-mini-app-frontend.pages.dev",
    "N8N_URL": "http://localhost:5678",
    "QWEN_TTS_URL": "http://localhost:8080",
    "NOVELAI_AGENT_PATH": "<path-to-novelai-lorebook-agent>",
    "MIRROR_LEECH_URL": "http://localhost:8095",
    "BLUESKY_PDS_URL": "http://localhost:2583"
  }
  // No kv_namespaces/d1_databases bound here — TMA_KV/TMA_DB are optional env bindings (see
  // Env in index.ts) and every D1/KV call already degrades gracefully when they're absent, so
  // the Worker deploys and runs fine without them. Profile caching, activity logging, and
  // /api/mission-log are inactive until a real KV namespace + D1 database are provisioned and
  // this block is restored with their real IDs. This also means `wrangler dev --local` won't
  // exercise those code paths locally anymore either — re-add the block locally if you need to.
}
