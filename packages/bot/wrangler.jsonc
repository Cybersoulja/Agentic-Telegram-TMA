{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trillastrob",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MINI_APP_URL": "https://telegram-mini-app-frontend.pages.dev",
    "N8N_URL": "http://localhost:5678",
    "QWEN_TTS_URL": "http://localhost:8080",
    "NOVELAI_AGENT_PATH": "<path-to-novelai-lorebook-agent>",
    "MIRROR_LEECH_URL": "http://localhost:8095",
    "BLUESKY_PDS_URL": "http://localhost:2583",
    "CRAFT_API_URL": ""
  },
  "kv_namespaces": [
    {
      "binding": "TMA_KV",
      "id": "3d0f0965850040bd8d86e8c61553c1fc"
    }
  ],
  "d1_databases": [
    {
      "binding": "TMA_DB",
      "database_name": "tma_db",
      "database_id": "a02c548f-0885-497f-b7c9-eb760fdf37b5"
    }
  ]
}
